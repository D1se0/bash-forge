{
  "name": "bash-forge",
  "version": "1.0.0",
  "private": true,
  "description": "Learn Bash scripting, for real: web terminal + Ubuntu sandbox + validated lessons.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
