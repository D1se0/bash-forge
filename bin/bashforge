#!/usr/bin/env bash
# bashforge — CLI del proyecto: levanta el stack, genera lecciones y comprueba el entorno.
set -euo pipefail

# Localiza la raíz del repo aunque el CLI esté instalado en ~/.local/bin:
# 1) symlink → el fichero real  2) BASHFORGE_HOME  3) subir desde $PWD hasta el marcador
locate_root() {
  local src="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1 && [[ -L "$src" ]]; then
    src="$(readlink -f "$src")"
  fi
  local d
  d="$(cd "$(dirname "$src")/.." && pwd)"
  if [[ -f "$d/docker/docker-compose.yml" ]]; then
    printf '%s\n' "$d"
    return 0
  fi
  if [[ -n "${BASHFORGE_HOME:-}" && -f "$BASHFORGE_HOME/docker/docker-compose.yml" ]]; then
    printf '%s\n' "$BASHFORGE_HOME"
    return 0
  fi
  local cur="$PWD"
  while [[ "$cur" != "/" ]]; do
    if [[ -f "$cur/docker/docker-compose.yml" && -f "$cur/bin/bashforge" ]]; then
      printf '%s\n' "$cur"
      return 0
    fi
    cur="$(dirname "$cur")"
  done
  return 1
}

if ! DIR="$(locate_root)"; then
  echo "✕ bashforge: no encuentro la raíz del repo bash-forge." >&2
  echo "  Si lo instalaste copiando el script a ~/.local/bin, usa un symlink en su lugar:" >&2
  echo "    ln -sf '<ruta>/bash-forge/bin/bashforge' ~/.local/bin/bashforge" >&2
  echo "  O ejecuta el CLI desde la raíz del repo, o exporta BASHFORGE_HOME='<ruta>/bash-forge'." >&2
  exit 1
fi
WEB_PORT="${WEB_PORT:-8080}"
SANDBOX_PORT="${SANDBOX_PORT:-8010}"
COMPOSE=(docker compose -f "$DIR/docker/docker-compose.yml" --env-file "$DIR/docker/.env")

usage() {
  cat <<'EOF'
Uso: bashforge <comando>

  dev            Arranca el stack completo con docker compose up (web :8080) y espera la salud del sandbox.
  down           Para y limpia el stack de docker.
  status         Estado del stack: contenedores, puertos y salud del sandbox.
  purge [s|n]    Purga total: respalda el progreso de los alumnos, pide confirmación (s|n, o --yes / --no)
                 y borra contenedores + volúmenes + imágenes del proyecto.
  lessons        (Re)genera el currículum en packages/lessons/lessons/.
  check          Ejecuta typecheck + build de todos los workspaces.
  list           Lista lecciones disponibles (requiere sandbox arriba).
  verify <id>    Verifica una lección: GET /api/lessons/:id y muestra la validación.
  help           Esta ayuda.
EOF
}

ensure_secrets() {
  if [[ ! -f "$DIR/docker/.env" ]]; then
    cp "$DIR/docker/.env.example" "$DIR/docker/.env"
    echo "· docker/.env creado desde plantilla"
  fi
}

have_node() { command -v node >/dev/null 2>&1; }

lessons_count() {
  # cuenta ids de lección en el catálogo (única fuente: /api/lessons)
  if have_node; then
    node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{console.log(JSON.parse(d).length)}catch{console.log(0)}})' <<< "$(curl -fsS "http://localhost:$SANDBOX_PORT/api/lessons" 2>/dev/null)"
  else
    curl -fsS "http://localhost:$SANDBOX_PORT/api/lessons" 2>/dev/null | grep -o '"id":"[a-z][a-z0-9-]*"' | wc -l
  fi
}

cmd_status() {
  ensure_secrets
  echo "· contenedores del stack"
  local out
  out=$("${COMPOSE[@]}" ps --format '{{.Name}}\t{{.Status}}\t{{.Ports}}' 2>&1) || out=""
  if [[ -n "$out" ]]; then
    while IFS= read -r line; do echo "  $line"; done <<< "$out"
  else
    echo "  (sin contenedores del stack: usa bashforge dev)"
  fi
  if curl -fsS "http://localhost:$SANDBOX_PORT/api/health" >/dev/null 2>&1; then
    echo "· sandbox OK en :$SANDBOX_PORT ($(lessons_count) lecciones en el catálogo)"
  else
    echo "· sandbox NO responde en :$SANDBOX_PORT"
  fi
  if curl -fsS "http://localhost:$WEB_PORT" >/dev/null 2>&1; then
    echo "· web OK en :$WEB_PORT"
  else
    echo "· web NO responde en :$WEB_PORT"
  fi
}

marca_progreso() {
  # Respaldamos el progreso de TODOS los alumnos del volumen en un directorio
  # con ficheros importables desde la web (Importar JSON acepta el snapshot tal cual).
  local dest="$1"
  local alumnos
  alumnos=$(curl -fsS "http://localhost:$SANDBOX_PORT/api/progress" 2>/dev/null | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{console.log(JSON.parse(d).students.join("\n"))}catch{console.log("")}})')
  [[ -z "$alumnos" ]] && return 1
  local n=0
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if curl -fsS "http://localhost:$SANDBOX_PORT/api/progress/$f" -o "$dest/bashforge-progreso-$f.json"; then
      n=$((n + 1))
    fi
  done <<< "$alumnos"
  echo "· respaldados $n snapshot(s) de progreso en $dest (importables con «Importar JSON»)"
  return 0
}

cmd_purge() {
  ensure_secrets
  local respuesta="${1:-}"
  local backup_ok=0
  local fecha
  fecha=$(date +%Y%m%d-%H%M%S)
  local backup_dir="$DIR/backups/progreso-$fecha"

  echo "· purga total del stack (contenedores + volúmenes + imágenes locales)"

  # ── seguridad: respaldar el progreso del servidor ANTES de borrar volúmenes ──
  if curl -fsS "http://localhost:$SANDBOX_PORT/api/progress" >/dev/null 2>&1; then
    mkdir -p "$backup_dir"
    if marca_progreso "$backup_dir"; then
      backup_ok=1
    else
      echo "· sin progreso guardado en el servidor: nada que respaldar"
      rmdir "$backup_dir" 2>/dev/null || true
    fi
  else
    echo "· sandbox parado o sin /api/progress: no hay progreso del servidor que respaldar"
  fi

  echo "  ⚠ El progreso que vive SOLO en el navegador (localStorage) no lo toca la purga."
  echo "  ⚠ Si tienes progreso SOLO en el navegador y no en la forja, expórtalo desde"
  echo "     la web (⇪ Exportar JSON) antes de continuar."
  if [[ "$backup_ok" == 1 ]]; then
    echo "     Los JSON de $backup_dir se pueden importar más tarde desde «⇩ Importar JSON»."
  fi

  # ── confirmación ──
  case "$respuesta" in
    --yes|s|si|sí|y|yes|"") respuesta="s" ;;
    --no|n|no) respuesta="n" ;;
    *)
      if [[ -t 0 ]]; then
        read -r -p "¿Continuar con la purga? [s/N] " respuesta
        case "$respuesta" in s|si|sí|S|SI|Sí|y|Y) respuesta="s" ;; *) respuesta="n" ;; esac
      else
        respuesta="s"  # no interactiva (CI): seguimos; el respaldo ya se intentó
      fi
      ;;
  esac
  if [[ "$respuesta" != "s" ]]; then
    echo "· purga cancelada: no se ha borrado nada"
    return 0
  fi

  "${COMPOSE[@]}" down --volumes --rmi local || true
  echo "· purga completada"
}

cmd_dev() {
  ensure_secrets
  echo "· levantando sandbox + web 🐳"
  "${COMPOSE[@]}" up --build -d
  echo -n "· esperando la salud del sandbox"
  for _ in $(seq 1 30); do
    if curl -fsS "http://localhost:$SANDBOX_PORT/api/health" >/dev/null 2>&1; then
      echo " OK"
      echo "· listo: http://localhost:$WEB_PORT (terminal + lecciones)"
      return 0
    fi
    echo -n "."
    sleep 1
  done
  echo ""
  echo "  ⚠ el sandbox sigue sin responder tras 30s; mira los logs: docker compose -f docker/docker-compose.yml logs sandbox"
  return 1
}

cmd_down() {
  "${COMPOSE[@]}" down --volumes
  echo "· stack parado y volúmenes limpiados"
}

cmd_lessons() {
  (cd "$DIR/packages/lessons" && node generator.mjs)
}

cmd_check() {
  for ws in packages/shared apps/sandbox-server apps/web; do
    echo "· typecheck $ws"
    (cd "$DIR/$ws" && npx tsc --noEmit -p tsconfig.json)
  done
  echo "· build sandbox"
  (cd "$DIR/apps/sandbox-server" && npm run build)
  echo "· build web"
  (cd "$DIR/apps/web" && npm run build)
  echo "✔ todo en verde"
}

cmd_list() {
  local json
  json=$(curl -fsS "http://localhost:$SANDBOX_PORT/api/lessons") || { echo "✕ sandbox sin respuesta en :$SANDBOX_PORT"; exit 1; }
  if have_node; then
    # shellcheck disable=SC2016  # las ${} van dentro del nodo, sin expandir en bash
    node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{const ls=JSON.parse(d);const pra=ls.filter(l=>l.track).length;for(const l of ls)console.log(`${l.track?`[${l.track}]`.padEnd(9):`l${l.level}`.padEnd(9)}  ${l.id.padEnd(24)} ${l.title}`);console.log(`\n${ls.length} lecciones (${ls.length-pra} del camino + ${pra} de práctica dirigida)`)})' <<< "$json"
  else
    echo "$json" | grep -o '"id":"[a-z][a-z0-9-]*"' | sed 's/"id":"//;s/"//' | sort
  fi
}

cmd_verify() {
  local id="${1:-}"
  [[ -z "$id" ]] && {
    echo "falta id de lección. Ejemplos:"
    curl -fsS "http://localhost:$SANDBOX_PORT/api/lessons" 2>/dev/null | grep -o '"id":"[a-z][a-z0-9-]*"' | sed 's/"id":"//;s/"//' | head -20 || true
    echo
    exit 1
  }
  local http
  http=$(curl -sS -o /dev/null -w '%{http_code}' "http://localhost:$SANDBOX_PORT/api/lessons/$id") || { echo "✕ sandbox sin respuesta en :$SANDBOX_PORT"; exit 1; }
  if [[ "$http" != "200" ]]; then
    echo "✕ la lección «$id» no existe (HTTP $http)"
    echo "  usa «bashforge list» para ver los ids"
    exit 1
  fi
  curl -fsS "http://localhost:$SANDBOX_PORT/api/lessons/$id" | head -c 2000; echo
}

case "${1:-help}" in
  dev) shift; cmd_dev "$@" ;;
  down) cmd_down ;;
  status) cmd_status ;;
  purge|purga) shift; cmd_purge "$@" ;;
  lessons) cmd_lessons ;;
  check) cmd_check ;;
  list) cmd_list ;;
  verify) shift; cmd_verify "$@" ;;
  help|--help|-h) usage ;;
  *) echo "comando desconocido: $1"; usage; exit 1;;
esac
